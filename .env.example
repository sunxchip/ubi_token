# 서버 설정
SERVER_BASE_URL=http://YOUR_SERVER_IP:8000

# ITS OpenAPI 키 (trafficInfo, VSL 모두 동일 키 사용)
ITS_API_KEY=YOUR_ITS_API_KEY

# ITS 교통소통정보 API (통행속도 조회 — 제한속도 아님)
ITS_TRAFFIC_API_URL=https://openapi.its.go.kr:9443/trafficInfo

# ITS VSL API (가변형 속도제한표지 — 제한속도 조회용)
# TODO: ITS VSL API 엔드포인트 확정 후 입력
ITS_VSL_API_URL=https://openapi.its.go.kr:9443/vslInfo
